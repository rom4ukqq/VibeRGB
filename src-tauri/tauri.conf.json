{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeRGB",
  "version": "0.2.5",
  "identifier": "local.vibergb.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "VibeRGB", "visible": false, "width": 1080, "height": 720, "minWidth": 760, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBNzgyNTczQTQxRTE5MDEKUldRQkdSNmtjeVY0Q2k5WmRaZHFLTklpZFI4cThDbEZxZ2czVHZKZGJxK2Q0cjI4bmdwTGJpdHUK",
      "endpoints": ["https://github.com/rom4ukqq/VibeRGB/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/pawnio/COPYING", "resources/pawnio/README.txt"]
  }
}
